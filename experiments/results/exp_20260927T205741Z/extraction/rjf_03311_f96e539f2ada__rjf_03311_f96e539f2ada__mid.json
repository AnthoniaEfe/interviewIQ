  "job": {
    "title": "Senior Accountant",
    "seniority": "Senior",
    "years_of_experience": "Minimum 8+ years of accounting experience; minimum 5+ years in the nonprofit industry",
    "responsibilities": [
      "Deliver monthly financial reporting, analytics, and insight on performance metrics.",
      "Conduct analytical reviews for departmental and programmatic activities to support financial and budgetary forecasting.",
      "Develop an understanding of organization-wide departments, programs, funding streams, and cost structures.",
      "Analyze financial and operational results and report underlying causes for performance and variance.",
      "Assist with agency budgeting, forecasts, and scenario planning based on changing assumptions.",
      "Perform budget-to-actual variance analysis and identify causes, required adjustments, trends, personnel reclassifications, potential shortfalls or overruns, and cost-saving opportunities.",
      "Assist with weekly cash flow management reports and projections.",
      "Prepare monthly, quarterly, annual, and ad hoc financial statements with actual and projected financial positions.",
      "Ensure the integrity of key processes by understanding transaction flows and internal controls and recommending improvements.",
      "Work with the Finance & Accounting team to identify improvement opportunities.",
      "Support organizational and management practices related to the analysis, evaluation, development, and implementation of programs, policies, and procedures.",
      "Perform variance analyses and account reconciliations.",
      "Assist with month-end and year-end closing, reconciliations, external audit preparation, and audit schedules.",
      "Complete ad hoc requests, one-off projects, and other assigned duties.",
      "Provide daily financial oversight to ensure financial records are complete, accurate, and compliant with applicable accounting principles, policies, and regulations."
    ],

# LLM provider and routing
LLM_PROVIDER=openai
LLM_FAST_MODEL=gpt-5.6-luna
LLM_PRIMARY_MODEL=gpt-5.6-terra
LLM_FALLBACK_MODEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional future benchmarking (not used until OpenAI path is stable)
GOOGLE_API_KEY=

# Generation
LLM_TEMPERATURE=0.7
LLM_REASONING_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=4096

# Embeddings (local Sentence-Transformers; GPU optional)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=auto

# Question selection
QUESTION_POOL_SIZE=30
FINAL_QUESTION_COUNT=10
MMR_LAMBDA=0.7
QUESTION_SIMILARITY_THRESHOLD=0.85

# Retrieval thresholds (documented; not discarded silently)
TFIDF_MIN_SIMILARITY=0.0
BM25_MIN_SCORE=0.0
SEMANTIC_MIN_SIMILARITY=0.0

# Competency weighting
REQUIRED_COMPETENCY_WEIGHT=1.0
PREFERRED_COMPETENCY_WEIGHT=0.6

# Caching / research
ENABLE_LLM_CACHE=true
ENABLE_EXPERIMENT_LOGGING=true
DISABLE_CACHE_FOR_EXPERIMENTS=false
LOG_LEVEL=INFO
LOG_PROMPTS=false

# Pricing defaults sourced from OpenAI model docs (2026-09):
# Terra: $2.00 / $0.20 cached / $12.00 per 1M
# Luna:  $0.20 / $0.02 cached / $1.20 per 1M
# Override here if provider pricing changes; do not hard-code in business logic.
LLM_PRIMARY_INPUT_COST_PER_MILLION=2.0
LLM_PRIMARY_CACHED_INPUT_COST_PER_MILLION=0.2
LLM_PRIMARY_OUTPUT_COST_PER_MILLION=12.0
LLM_FAST_INPUT_COST_PER_MILLION=0.2
LLM_FAST_CACHED_INPUT_COST_PER_MILLION=0.02
LLM_FAST_OUTPUT_COST_PER_MILLION=1.2

# Validate configured model IDs against the provider catalog on startup.
# Fail closed: never silently substitute another model.
VALIDATE_MODELS_ON_STARTUP=false
